      _pythLeg(PYTH_MAINNET, PYTH_USDT_USD, _fullBand(), REAL_ORACLE_MAX_STALENESS),
      _chainlinkLeg(CHAINLINK_WBTC_USD, _fullBand(), true, REAL_ORACLE_MAX_STALENESS),
      1e16
