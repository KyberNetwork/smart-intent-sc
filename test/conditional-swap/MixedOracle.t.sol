  /// @dev Chainlink and Pyth agree on the live BTC price within 1%.
  function test_Fork_RealOracles_Agree() public {
    _updateForkPythPrices();
    (,, uint256 clRatio) = _readReal(_realChainlink(_fullBand(), _fullBand()));
    (,, uint256 pythRatio) = _readReal(_realPyth(_fullBand(), _fullBand()));
    uint256 diff = clRatio > pythRatio ? clRatio - pythRatio : pythRatio - clRatio;
    assertLt(diff * 10_000, clRatio * 100);
  }

  /// @dev tokenIn priced by Chainlink, tokenOut by Atlas - one leg per provider.
  function test_Mixed_ChainlinkAtlas_Pass(uint256 mode) public {
    mode = bound(mode, 0, 2);
    OracleConfig memory cfg = _config(
      _chainlinkLeg(address(feedIn), _band(USDT_USD, 100, 100)),
      _atlasLeg(ATLAS_WBTC_USD, _band(WBTC_PER_USD, 100, 100), true),
      0
    );
    _expectAtlasSwapOk(mode, cfg, _amountOutFor(ORACLE_RATIO));
  }

